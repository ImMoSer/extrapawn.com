{
  "name": "extrapawn.com",
  "version": "2.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=11.0.0"
  },
  "pnpm": {
    "approvedBuilds": [
      "@parcel/watcher",
      "esbuild",
      "protobufjs",
      "stockfish",
      "unrs-resolver",
      "vue-demi"
    ]
  },
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "test:unit": "vitest",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "lint": "eslint . --fix",
    "type-check:watch": "vue-tsc --watch",
    "format": "prettier --write src/",
    "postinstall": "node -e \"import fs from 'fs'; fs.mkdirSync('public/stockfish', { recursive: true }); fs.cpSync('node_modules/stockfish/bin', 'public/stockfish', { recursive: true });\""
  },
  "dependencies": {
    "@lichess-org/chessground": "^10.1.1",
    "@tanstack/vue-query": "^5.101.2",
    "@vicons/ionicons5": "^0.13.0",
    "stockfish": "^18.0.8",

    "chessops": "^0.15.1",
    "dexie": "^4.4.4",
    "dompurify": "^3.4.12",
    "echarts": "^6.1.0",
    "idb": "^8.0.3",
    "naive-ui": "^2.44.1",
    "pinia": "^4.0.2",
    "tslib": "^2.8.1",
    "vue": "^3.5.40",
    "vue-echarts": "^8.0.1",
    "vue-i18n": "^11.4.6",
    "vue-router": "^5.2.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tsconfig/node22": "^22.0.5",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^26.1.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/eslint-plugin": "^1.6.23",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.7.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^7.0.2",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-vue": "^10.9.2",
    "jiti": "^2.6.1",
    "jsdom": "^29.1.1",
    "npm-run-all2": "^9.0.2",
    "prettier": "^3.9.5",
    "rollup-plugin-visualizer": "^7.0.1",
    "sass": "^1.101.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "unplugin-auto-import": "^21.0.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.1.5",
    "vite-plugin-vue-devtools": "^8.1.5",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.7"
  },
  "packageManager": "pnpm@11.14.0"
}
