{
  "name": "extrapawn.com",
  "version": "2.1.6",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=11.0.0"
  },
  "pnpm": {
    "approvedBuilds": [
      "@parcel/watcher",
      "esbuild",
      "protobufjs",
      "stockfish",
      "unrs-resolver",
      "vue-demi"
    ]
  },
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "test:unit": "vitest",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "lint": "eslint . --fix",
    "type-check:watch": "vue-tsc --watch",
    "format": "prettier --write src/",
    "postinstall": "node -e \"import fs from 'fs'; fs.rmSync('public/stockfish', { recursive: true, force: true }); fs.mkdirSync('public/stockfish', { recursive: true }); fs.cpSync('node_modules/stockfish/bin', 'public/stockfish', { recursive: true });\""
  },
  "dependencies": {
    "@lichess-org/chessground": "^10.5.0",
    "@tanstack/vue-query": "^5.104.5",
    "@vicons/ionicons5": "^0.13.0",
    "chessops": "^0.15.1",
    "dexie": "^4.4.6",
    "dompurify": "^3.4.17",
    "echarts": "^6.1.0",
    "idb": "^8.0.4",
    "naive-ui": "^2.45.3",
    "pinia": "^4.1.0",
    "stockfish": "^19.0.1",
    "tslib": "^2.8.1",
    "vue": "^3.5.44",
    "vue-echarts": "^8.3.2",
    "vue-i18n": "^11.4.16",
    "vue-router": "^5.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tsconfig/node22": "^22.0.6",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^26.6.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/eslint-plugin": "^1.6.27",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.13.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^7.2.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-vue": "^10.11.1",
    "jiti": "^2.7.0",
    "jsdom": "^29.1.1",
    "npm-run-all2": "^9.0.3",
    "prettier": "^3.9.10",
    "rollup-plugin-visualizer": "^7.1.1",
    "sass": "^1.106.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "unplugin-auto-import": "^21.1.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.3.5",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vitest": "^4.1.12",
    "vue-tsc": "^3.3.13"
  },
  "packageManager": "pnpm@11.14.0"
}
